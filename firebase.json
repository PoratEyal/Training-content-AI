      "headers": [
        {
          "source": "/he/**",
          "headers": [
            {
              "key": "Content-Language",
              "value": "he-IL"
            }
          ]
        },
        {
          "source": "/en/**",
          "headers": [
            {
              "key": "Content-Language",
              "value": "en"
            }
          ]
        },
        {
          "source": "/es/**",
          "headers": [
            {
              "key": "Content-Language",
              "value": "es"
            }
          ]
        },
        {
          "source": "/ar/**",
