{
  "functions": {
    "source": "functions",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ],
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "hosting": [
    {
      "site": "activity-wizard",
      "public": "build",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/he",
          "destination": "/he/youth",
          "type": 301
        },
        {
          "source": "/en",
          "destination": "/en/youth",
          "type": 301
        },
        {
          "source": "/es",
          "destination": "/es/youth",
          "type": 301
        },
        {
          "source": "/ar",
          "destination": "/ar/youth",
          "type": 301
        }
      ],
      "rewrites": [
        { 
          "source": "/static/**",
          "destination": "/static"
        },
        {
          "source": "/logo192.png",
          "destination": "/logo192.png"
        },
        {
          "source": "/logo512.png",
          "destination": "/logo512.png"
        },
        {
          "source": "/manifest.json",
          "destination": "/manifest.json"
        },
        {
          "source": "/BingSiteAuth.xml",
          "destination": "/index.html"
        },
        {
          "source": "/he/words",
          "destination": "/index.words.he.html"
        },
        {
          "source": "/he/words/**",
          "destination": "/index.words.he.html"
        },
        {
          "source": "/en/words",
          "destination": "/index.words.en.html"
        },
        {
          "source": "/en/words/**",
          "destination": "/index.words.en.html"
        },
        {
          "source": "/es/words",
          "destination": "/index.words.es.html"
        },
        {
          "source": "/es/words/**",
          "destination": "/index.words.es.html"
        },
        {
          "source": "/ar/words",
          "destination": "/index.words.ar.html"
        },
        {
          "source": "/ar/words/**",
          "destination": "/index.words.ar.html"
        },
        {
          "source": "/practice",
          "destination": "/index.html"
        },
        {
          "source": "/practice/**",
          "destination": "/index.html"
        },
        {
          "source": "/he/**",
          "destination": "/index.html"
        },
        {
          "source": "/en/**",
          "destination": "/index.html"
        },
        {
          "source": "/es/**",
          "destination": "/index.html"
        },
        {
          "source": "/ar/**",
          "destination": "/index.html"
        },
        {
          "source": "/youth",
          "destination": "/index.html"
        },
        {
          "source": "/he/youth",
          "destination": "/index.html"
        },
        {
          "source": "/en/youth",
          "destination": "/index.html"
        },
        {
          "source": "/es/youth",
          "destination": "/index.html"
        },
        {
          "source": "/ar/youth",
          "destination": "/index.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/he/**",
          "headers": [
            {
              "key": "Content-Language",
              "value": "he"
            }
          ]
        },
        {
          "source": "/en/**",
          "headers": [
            {
              "key": "Content-Language",
              "value": "en"
            }
          ]
        },
        {
          "source": "/es/**",
          "headers": [
            {
              "key": "Content-Language",
              "value": "es"
            }
          ]
        },
        {
          "source": "/fr/**",
          "headers": [
            {
              "key": "Content-Language",
              "value": "fr"
            }
          ]
        },
        {
          "source": "/ar/**",
          "headers": [
            {
              "key": "Content-Language",
              "value": "ar"
            }
          ]
        }
      ]
    }
  ]
}