            "region": "us-central1"
          }
        },
        {
          "source": "/practice",
          "function": {
            "functionId": "redirectToLang",
            "region": "us-central1"
          }
        },
        {
          "source": "/words",
          "function": {
            "functionId": "redirectToLang",
            "region": "us-central1"
          }
        },
        {
          "source": "/static/**",
          "destination": "/static"
        },
        {
          "source": "/logo192.png",
          "destination": "/logo192.png"
        },
        {
          "source": "/logo512.png",
          "destination": "/logo512.png"
        },
        {
          "source": "/manifest.json",
          "destination": "/manifest.json"
