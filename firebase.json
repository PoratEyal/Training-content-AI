{
  "functions": {
    "source": "functions",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ],
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "hosting": [
    {
      "site": "activity-wizard",
      "public": "build",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/he",
          "destination": "/he/youth",
          "type": 301
        },
        {
          "source": "/en",
          "destination": "/en/youth",
          "type": 301
        },
        {
          "source": "/es",
          "destination": "/es/youth",
          "type": 301
        },
        {
          "source": "/ar",
          "destination": "/ar/youth",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "/content/**",
          "function": {
            "functionId": "noContent410",
            "region": "us-central1"
          }
        },
        {
          "source": "/he/content/**",
          "function": {
            "functionId": "noContent410",
            "region": "us-central1"
          }
        },
        {
          "source": "/",
          "function": {
            "functionId": "redirectToLang",
            "region": "us-central1"
          }
        },
        {
          "source": "/youth",
          "function": {
            "functionId": "redirectToLang",
            "region": "us-central1"
          }
        },
        {
          "source": "/event",
          "function": {
            "functionId": "redirectToLang",
            "region": "us-central1"
          }
        },
        {
          "source": "/best",
